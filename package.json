{
  "name": "livex-scheduling-assistant",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "next dev",
    "dev:api": "node scripts/run-python.mjs -m backend.server",
    "chat": "node scripts/run-python.mjs -m backend.cli",
    "build": "next build",
    "lint": "eslint .",
    "test": "vitest run && node scripts/run-python.mjs -m unittest discover -s tests",
    "check": "node scripts/run-python.mjs -m scripts.check",
    "eval": "node scripts/run-python.mjs -m evals.runner",
    "cal:probe": "node scripts/run-python.mjs -m scripts.cal_probe",
    "model:probe": "node scripts/run-python.mjs -m scripts.model_probe",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "1.78.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
