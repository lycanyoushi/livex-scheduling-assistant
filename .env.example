# Copy to .env.local. Use an unbilled Gemini project and an isolated Cal.com test account.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=minimal
# Leave this empty to disable the separate free-tier backup model.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

CAL_API_KEY=
CAL_API_BASE_URL=https://api.cal.com
CAL_EVENT_TYPE_SLUGS=
CAL_DEFAULT_EVENT_TYPE_SLUG=
# Set to fake to use the in-memory calendar without a Cal.com key.
DEMO_MODE=
# Fake calendar availability and seed clock. Leave empty for America/Los_Angeles.
DEMO_TIME_ZONE=
# For the Cal.com write probe, use two test aliases on an inbox you control.
CAL_PROBE_ATTENDEE_EMAIL=
CAL_PROBE_CONFLICT_EMAIL=
# Optional five controlled test inbox aliases, used only with the demo seeder's explicit flag.
CAL_DEMO_ATTENDEE_EMAILS=

# Generate at least 32 random bytes and save the value only in .env.local.
STATE_SIGNING_SECRET=
# Use a private random access code for the web app. Optional in demo mode.
OWNER_ACCESS_CODE=
RATE_LIMIT_TURNS_PER_10MIN=30
# Set below the model's free-tier daily quota for your AI Studio project.
DAILY_MODEL_CALL_CAP=500
